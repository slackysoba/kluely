# Server-side only. No key is ever sent to the browser.
# Inworld is the default transcription provider; AssemblyAI is the toggle option.
INWORLD_API_KEY=
ASSEMBLYAI_API_KEY=
GEMINI_API_KEY=

# --- Notetaker Mode (Recall.ai) ---
# Server-side only. RECALL_API_KEY must NEVER be exposed to the client.
# Sent to Recall as the raw Authorization header value (no "Bearer" prefix).
RECALL_API_KEY=
# Recall region for the API base URL, e.g. us-west-2 -> https://us-west-2.recall.ai
RECALL_REGION=us-west-2
# Public origin of the deployed site, used to build the webhook callback URL.
# e.g. https://kluelyapp.com  (no trailing slash)
PUBLIC_BASE_URL=

# Redis connection string for Notetaker transcript state (provisioned in Vercel).
# ioredis-compatible URL (redis:// or rediss://). Do NOT use the @vercel/kv REST SDK.
REDIS_URL=

# Set to 1 to log full raw Recall webhook payloads to the server logs (Vercel).
# Leave unset/empty in normal operation.
DEBUG_RECALL=
